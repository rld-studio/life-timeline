      "id": "evt-2017-01-09-bama-title",
      "title": "Alabama National Championship",
      "start_date": "2017-01-09",
      "end_date": "2017-01-09",
      "category": "sports",
      "color": "#3b82f6",
      "location": "Atlanta, GA",
      "tags": [
        "alabama",
        "cfp",
        "championship"
      ],
      "artifacts": [
        {
          "type": "text",
          "content": "Witnessed 2nd and 26 — Tua to DeVonta Smith for a walk-off TD in OT. Turner suite, 50 yard line. Ticket gifted by Matt Hong (originally for Harold Raines). Attended with Matt and PR head Nate Smeltz. Trump had worse seats. Houston Nutt was in the next suite, leaning on the rail cursing under his breath watching Saban lift the trophy on the jumbotron. Stood behind Tim Tebow in the security line."
        }
      ]
